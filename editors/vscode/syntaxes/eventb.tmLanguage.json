{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "Generated by `cargo xtask gen-grammars` from the canonical token tables. Do not edit by hand."
  ],
  "name": "Event-B",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#tokens_0"
    },
    {
      "include": "#tokens_1"
    },
    {
      "include": "#tokens_2"
    },
    {
      "include": "#tokens_3"
    },
    {
      "include": "#tokens_4"
    },
    {
      "include": "#tokens_5"
    },
    {
      "include": "#tokens_6"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.eventb"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.eventb"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "[a-zA-Z_][a-zA-Z0-9_]*'?",
          "name": "variable.other.eventb"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "@[^\\x{9}\\x{A}\\x{B}\\x{C}\\x{D}\\x{1C}\\x{1D}\\x{1E}\\x{1F}\\x{20}\\x{A0}\\x{1680}\\x{2000}\\x{2001}\\x{2002}\\x{2003}\\x{2004}\\x{2005}\\x{2006}\\x{2007}\\x{2008}\\x{2009}\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}]+",
          "name": "entity.name.tag.eventb"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.eventb"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.eventb",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.eventb"
            }
          ]
        }
      ]
    },
    "tokens_0": {
      "match": "(?i)\\b(any|axioms|begin|constants|context|end|event|events|extends|initialisation|invariants|machine|refines|sees|sets|status|then|theorems|variables|variant|when|where|with|witness)\\b",
      "name": "keyword.control.eventb"
    },
    "tokens_1": {
      "match": "(?i)\\b(anticipated|convergent|ordinary|skip|theorem)\\b",
      "name": "keyword.other.eventb"
    },
    "tokens_2": {
      "match": "(ℕ1|ℕ|ℤ|∅|⊤|⊥|\\{\\})",
      "name": "constant.language.eventb"
    },
    "tokens_3": {
      "match": "\\b(BOOL|FALSE|INT|NAT|NAT1|TRUE|bool|false|true)\\b",
      "name": "constant.language.eventb"
    },
    "tokens_4": {
      "match": "\\b(card|finite|id|max|min|partition|pred|prj1|prj2|succ)\\b",
      "name": "support.function.eventb"
    },
    "tokens_5": {
      "match": "(<<->>|/<<:|:∈|:∣|<->>|<<->|>->>|ℙ1|\\+->|\\+>>|-->|->>|/<:|<->|<<:|<<\\||<=>|>\\+>|>->|\\|->|\\|>>|‥|ℙ|→|↔|↠|↣|↦|⇒|⇔|⇸|∀|∃|∈|∉|−|∖|∗|∘|∣|∥|∧|∨|∩|∪|∼|≔|≠|≤|≥|⊂|⊄|⊆|⊈|⊗|⋂|⋃|▷|◁|⤀|⤔|⤖|⦂|⩤|⩥|||||\\*\\*|\\.\\.|/:|/=|/\\\\|::|:=|:\\||<\\+|<:|<=|<\\||=>|><|>=|\\\\/|\\|>|\\|\\||¬|·|×|÷|λ|!|#|%|&|\\*|\\+|-|\\.|/|:|;|<|=|>|\\\\|\\^|\\||~)",
      "name": "keyword.operator.eventb"
    },
    "tokens_6": {
      "match": "\\b(INTER|POW|POW1|UNION|circ|dom|mod|not|oftype|or|ran)\\b",
      "name": "keyword.operator.eventb"
    }
  },
  "scopeName": "source.eventb"
}
